# Copy to .env and fill in. docker compose reads .env automatically.
# These map to config.json fields; see README "Configuration via environment".

# --- Required ---
RD_HTTP_URL=https://your-routing-director-host/
RD_ORG_ID=your-organization-id

# --- Auth: choose ONE ---
# Token auth:
RD_AUTH_TOKEN=your-api-token
# Basic auth (use instead of the token above):
# RD_AUTH_USERNAME=your-username@example.com
# RD_AUTH_PASSWORD=your-password
# Optional explicit type ("token" or "basic"); inferred from the above if omitted.
# RD_AUTH_TYPE=token

# --- Optional ---
# RD_COMPONENTS=ems,device-kpi
# RD_OPENAPI_SPEC=/app/jrd-2.8.0-mcp-spec.json

# MLflow tracing (see README). Set ENABLED=true and a tracking URI to turn it on.
# RD_MLFLOW_ENABLED=true
# RD_MLFLOW_TRACKING_URI=http://your-mlflow-host:5000
# RD_MLFLOW_EXPERIMENT=routing-director-mcp

# Log verbosity: ERROR (default) | WARNING | INFO | DEBUG
# LOG_LEVEL=INFO
